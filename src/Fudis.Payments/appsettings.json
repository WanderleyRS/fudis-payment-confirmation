{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fudis": "Server=(localdb)\\MSSQLLocalDB;Database=FudisPayments;Trusted_Connection=True;MultipleActiveResultSets=True"
